# pkgsearch [query] — list and install packages from the repos (pacman/pikaur)
# adapted from https://github.com/DanielFGray/fzf-scripts

p() {
	_pkgsearch_check fzf pikaur || return 1
	_pkgsearch_arch "$*"
}

_pkgsearch_err() { printf '\033[31m%s\033[0m\n' "$*" >&2; }

_pkgsearch_check() {
	local c
	for c; do
		command -v "$c" &>/dev/null || {
			_pkgsearch_err "$c not found"
			return 1
		}
	done
}

_pkgsearch_fzf() {
	command fzf -e +s --multi --cycle --ansi \
		--no-hscroll --info=inline "$@"
}

_pkgsearch_install() {
	local pkgs count
	pkgs=(${(f)$(cat)})
	((${#pkgs} > 0)) || return 0
	count="${#pkgs[@]} package"
	((${#pkgs[@]} > 1)) && count+='s'
	printf "installing %s: %s\n" "$count" "${pkgs[*]}"
	"$1" "${pkgs[@]}" </dev/tty
}

_pkgsearch_arch() {
	local esc=$'\033'
	local c_blue="${esc}[34m" c_green="${esc}[32m" c_reset="${esc}[0m"
	local search packages
	search='pacman'
	[[ -n "$1" ]] && search='pikaur'
	packages=$(_pkgsearch_fzf --preview-window=down --preview="$search -Si {2}" \
	< <(
		"$search" -Ss "$1" |
			gawk '{
        getline descr;
        sub(/ */,"", descr);
        repo = blue "[" gensub(/\/.*/, "", 1) "]" reset;
        name = green gensub(/.*\//, "", 1, $1) reset;
        info = gensub(/[^ ]* /, "", 1);
        print repo, name, info, descr;
      }' blue="$c_blue" green="$c_green" reset="$c_reset"
	) | cut -d' ' -f2)
	[[ "$search" = "pacman" ]] && search="sudo pacman"
	_pkgsearch_install "$search -S" <<<"$packages"
}
